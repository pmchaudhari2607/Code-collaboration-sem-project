PORT=5000
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=7d
ENABLE_DEV_MODE=true
# Must EXACTLY match the origin (protocol + host + port) the frontend is actually served from ('localhost' and '127.0.0.1' are different).
CORS_ORIGIN=http://127.0.0.1:5500

# Database Configuration (dev/test only)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=code_review_portal_dev
DB_USER=crh_app
DB_PASSWORD=your_db_password

