PORT=5000
JWT_SECRET=replace_with_a_secure_jwt_secret_at_least_32_characters
JWT_EXPIRES_IN=7d
ENABLE_DEV_MODE=false
# Supported CORS origin(s). Supports single origin, '*', or comma-separated list.
CORS_ORIGIN=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:3000,http://localhost:3000

# Database Configuration (MySQL 8.0 on port 3307)
DB_ENABLED=true
DB_TARGET=dev
DB_HOST=localhost
DB_PORT=3307
DB_NAME=code_review_portal_dev
DB_NAME_TEST=code_review_portal_test
DB_USER=crh_app
DB_PASSWORD=your_db_password
DB_POOL_LIMIT=10


